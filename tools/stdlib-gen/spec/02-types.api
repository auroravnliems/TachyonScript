# Types used across the other specifications (declared first so every file can use them).

area Types

# ------------------------------------------------------------------ keyed types (Type.CONSTANT)

type Material keyed=enum:org/bukkit/Material.java lookup=keyed-enum = org.bukkit.Material : A block or item type: Material.DIAMOND, Material.OAK_LOG, ...
type EntityType keyed=enum:org/bukkit/entity/EntityType.java lookup=keyed-enum = org.bukkit.entity.EntityType : A kind of entity: EntityType.ZOMBIE, EntityType.ARMOR_STAND, ...
type Sound keyed=fields:org/bukkit/Sound.java:getSound lookup=registry:SOUND_EVENT = org.bukkit.Sound : A sound: Sound.ENTITY_PLAYER_LEVELUP, Sound.BLOCK_NOTE_BLOCK_PLING, ...
type Particle keyed=enum:org/bukkit/Particle.java lookup=keyed-enum = org.bukkit.Particle : A particle effect: Particle.FLAME, Particle.HEART, ...
type PotionEffectType keyed=fields:org/bukkit/potion/PotionEffectType.java:getPotionEffectType lookup=registry:MOB_EFFECT = org.bukkit.potion.PotionEffectType : A potion effect: PotionEffectType.SPEED, PotionEffectType.REGENERATION, ...
type Enchantment keyed=fields:org/bukkit/enchantments/Enchantment.java:getEnchantment lookup=registry:ENCHANTMENT = org.bukkit.enchantments.Enchantment : An enchantment: Enchantment.SHARPNESS, Enchantment.MENDING, ...
type Biome keyed=fields:org/bukkit/block/Biome.java:getBiome lookup=registry:BIOME = org.bukkit.block.Biome : A biome: Biome.PLAINS, Biome.DESERT, ...
type Attribute keyed=fields:org/bukkit/attribute/Attribute.java:getAttribute lookup=registry:ATTRIBUTE = org.bukkit.attribute.Attribute : An attribute: Attribute.MAX_HEALTH, Attribute.MOVEMENT_SPEED, ...
type BlockFace keyed=enum:org/bukkit/block/BlockFace.java lookup=enum = org.bukkit.block.BlockFace : A direction: BlockFace.NORTH, BlockFace.UP, ...
type ItemFlag keyed=enum:org/bukkit/inventory/ItemFlag.java lookup=enum = org.bukkit.inventory.ItemFlag : Hides part of an item's tooltip: ItemFlag.HIDE_ENCHANTS, ...
type EquipmentSlot keyed=enum:org/bukkit/inventory/EquipmentSlot.java lookup=enum = org.bukkit.inventory.EquipmentSlot : An equipment slot: EquipmentSlot.HEAD, EquipmentSlot.HAND, ...
type ClickType keyed=enum:org/bukkit/event/inventory/ClickType.java lookup=enum = org.bukkit.event.inventory.ClickType : How an inventory slot was clicked: ClickType.LEFT, ClickType.SHIFT_RIGHT, ...
type InventoryType keyed=enum:org/bukkit/event/inventory/InventoryType.java lookup=enum = org.bukkit.event.inventory.InventoryType : A kind of inventory: InventoryType.CHEST, InventoryType.HOPPER, ...
type Action keyed=enum:org/bukkit/event/block/Action.java lookup=enum = org.bukkit.event.block.Action : What a player did with their hand: Action.RIGHT_CLICK_BLOCK, Action.LEFT_CLICK_AIR, ...
type DamageCause keyed=enum:org/bukkit/event/entity/EntityDamageEvent.java#DamageCause lookup=enum = org.bukkit.event.entity.EntityDamageEvent.DamageCause : Why an entity took damage: DamageCause.FALL, DamageCause.ENTITY_ATTACK, ...
type SpawnReason keyed=enum:org/bukkit/event/entity/CreatureSpawnEvent.java#SpawnReason lookup=enum = org.bukkit.event.entity.CreatureSpawnEvent.SpawnReason : Why a creature spawned: SpawnReason.NATURAL, SpawnReason.SPAWNER, ...
type TeleportCause keyed=enum:org/bukkit/event/player/PlayerTeleportEvent.java#TeleportCause lookup=enum = org.bukkit.event.player.PlayerTeleportEvent.TeleportCause : Why a player teleported: TeleportCause.ENDER_PEARL, TeleportCause.COMMAND, ...
type Difficulty keyed=enum:org/bukkit/Difficulty.java lookup=enum = org.bukkit.Difficulty : A world difficulty: Difficulty.PEACEFUL, Difficulty.HARD, ...
type Environment keyed=enum:org/bukkit/World.java#Environment lookup=enum = org.bukkit.World.Environment : A kind of world: Environment.NORMAL, Environment.NETHER, Environment.THE_END.
type BarColor keyed=list:PINK,BLUE,RED,GREEN,YELLOW,PURPLE,WHITE lookup=enum = net.kyori.adventure.bossbar.BossBar.Color : A boss bar color: BarColor.RED, BarColor.BLUE, ...
type BarStyle keyed=list:PROGRESS,NOTCHED_6,NOTCHED_10,NOTCHED_12,NOTCHED_20 lookup=enum = net.kyori.adventure.bossbar.BossBar.Overlay : How a boss bar is divided: BarStyle.PROGRESS, BarStyle.NOTCHED_10, ...

# ------------------------------------------------------------------ values

type Vector storable = org.bukkit.util.Vector : A 3D vector (a direction or a velocity). Operations return new vectors.
  codec: Codecs.VECTOR
type Color storable = org.bukkit.Color : An RGB color, for leather armor, fireworks and dust particles.
  codec: Codecs.COLOR
type ItemStack storable = org.bukkit.inventory.ItemStack : A stack of items (type, amount, name, lore, enchantments...).
  codec: Codecs.ITEM_STACK
type PotionEffect storable = org.bukkit.potion.PotionEffect : A potion effect with a type, a duration and a level.
  codec: Codecs.POTION_EFFECT
type Chunk = org.bukkit.Chunk : A 16x16 column of blocks.
type Inventory = org.bukkit.inventory.Inventory : A container of item slots: a chest, a player's inventory, a menu...
type PlayerInventory extends Inventory = org.bukkit.inventory.PlayerInventory : A player's inventory with armor and hands.

# ------------------------------------------------------------------ entities

type Item extends Entity = org.bukkit.entity.Item : An item lying on the ground.
type Mob extends LivingEntity = org.bukkit.entity.Mob : A mob with AI (can have a target).
type Ageable extends Mob = org.bukkit.entity.Ageable : A mob that can be a baby.
type Animals extends Ageable = org.bukkit.entity.Animals : An animal that can breed.
type Tameable extends Animals = org.bukkit.entity.Tameable : An animal that can be tamed (wolf, cat, horse, ...).
type Monster extends Mob = org.bukkit.entity.Monster : A hostile mob.
type ArmorStand extends LivingEntity = org.bukkit.entity.ArmorStand : An armor stand.
type Projectile extends Entity = org.bukkit.entity.Projectile : A projectile (arrow, snowball, trident, ...).
type ExperienceOrb extends Entity = org.bukkit.entity.ExperienceOrb : An experience orb.
type FallingBlock extends Entity = org.bukkit.entity.FallingBlock : A falling block (sand, gravel, anvil, ...).
type TNTPrimed extends Entity = org.bukkit.entity.TNTPrimed : Lit TNT.
type TextDisplay extends Entity = org.bukkit.entity.TextDisplay : A floating text (a hologram line).

# ------------------------------------------------------------------ interface

type BossBar = net.kyori.adventure.bossbar.BossBar : A boss bar at the top of the screen, shown to chosen players.
type Sidebar = dev.tachyonscript.platform.paper.lib.Sidebar : A scoreboard sidebar shown to chosen players.
type Menu = dev.tachyonscript.platform.paper.lib.ScriptMenu : A chest menu (GUI) with click handlers per slot.
type MenuClick = dev.tachyonscript.platform.paper.lib.MenuClick : A click in a menu.
